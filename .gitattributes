# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Force specific text files to LF
*.md text eol=lf
*.txt text eol=lf
*.dax text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf

# Binary files that must not be modified
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.svg text
*.xlsx binary
*.pbix binary
*.zip binary
